{
  "title": "Amazon Price Monitor",
  "uid": "amazon-price-monitor",
  "tags": ["prices", "amazon"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5m",
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "product",
        "type": "query",
        "query": "label_values(amazon_product_price, name)",
        "refresh": 1,
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "title": "Current Prices",
      "type": "stat",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "options": {
        "orientation": "auto",
        "reduceOptions": { "values": true, "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "mappings": [],
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "amazon_product_price",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Price Trend",
      "type": "timeseries",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 8 },
      "options": {
        "legend": { "calcs": ["last", "min", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "min": 0,
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "amazon_product_price{$product}",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    }
  ]
}
